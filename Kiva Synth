desc:Kiva Synth

slider1:nSignals=2<1,80,1>Voices
slider2:octave=0<-3,3,1>Octave
slider3:waveshape=Saw<0,3,1{Saw,Square,Sine,Pulser}>Waveshape
slider4:gain_db=-24<-150,12,1>Gain (dB)
// phase_rand_amount is only really useful when manually doubling this synth on another channel.
slider5:phase_rand_amount=0<0,1,0.001>Absolute phase random %
slider6:voice_detune=0<0,1,0.001:log>Voice detune %

//slider8:env_attack=0<0,2000,1>Attack (ms)
slider9:env_decay=0<0,2000,1>Decay (ms)
//slider10:env_sustain
//slider11:env_release

slider12:env_detune_amount=0<-32,32,0.001:log>Detune env. amount
slider13:env_detune_length=2<0.01,16,0.001>Detune env. length (sec)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

